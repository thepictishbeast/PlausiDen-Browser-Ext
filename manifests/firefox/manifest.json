{
  "manifest_version": 3,
  "name": "PlausiDen",
  "version": "0.1.0",
  "description": "Privacy-preserving browsing noise generator",
  "permissions": ["history", "cookies", "storage", "alarms"],
  "background": {
    "scripts": ["background/service-worker.js"]
  },
  "action": {
    "default_popup": "popup/popup.html"
  },
  "options_page": "options/options.html",
  "browser_specific_settings": {
    "gecko": {
      "id": "plausiden@plausiden.com",
      "strict_min_version": "109.0"
    }
  }
}
